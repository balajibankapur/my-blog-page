---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Writing · ${SITE_TITLE}`;
const pageDescription = 'All posts on AI, agents, and software architecture.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={pageDescription} />
    <style>
      main {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 4rem;
        box-sizing: border-box;
      }
      .page-header {
        margin-bottom: 3rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .page-header h1 {
        font-size: 2rem !important;
        margin: 0 0 0.5rem;
        line-height: 1.2;
      }
      .page-header p {
        color: rgb(var(--gray-dark));
        margin: 0;
        font-size: 1rem;
      }
      ul.post-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      ul.post-list li {
        padding: 1.5rem 0;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      ul.post-list li:first-child { padding-top: 0; }
      ul.post-list li:last-child { border-bottom: 0; }
      ul.post-list a {
        text-decoration: none;
        color: inherit;
        display: block;
      }
      ul.post-list a:hover .post-title { color: var(--accent); }
      .post-title {
        font-size: 1.35rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
        line-height: 1.3;
      }
      .post-date {
        font-size: 0.85rem;
        color: rgb(var(--gray));
        margin: 0;
      }
      .post-desc {
        margin: 0.5rem 0 0;
        color: rgb(var(--gray-dark));
        line-height: 1.55;
      }
      @media (max-width: 640px) {
        main { padding: 2rem 1.1rem 3rem; }
        .page-header { margin-bottom: 2rem; }
        .page-header h1 { font-size: 1.6rem !important; }
        .post-title { font-size: 1.1rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <header class="page-header">
        <h1>Writing</h1>
        <p>Practical notes on AI, agents, and software architecture.</p>
      </header>
      <section>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <p class="post-title">{post.data.title}</p>
                <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
