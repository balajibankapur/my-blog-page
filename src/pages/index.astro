---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import balajiPhoto from '../assets/balaji.jpg';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        padding: 4rem 1.5rem 4rem;
        box-sizing: border-box;
      }

      /* HERO */
      .hero {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2.5rem;
        align-items: center;
        padding: 2.5rem 0 3rem;
        border-bottom: 1px solid rgb(var(--gray-light));
        margin-bottom: 3rem;
      }
      .hero-text { min-width: 0; }
      .eyebrow {
        display: inline-block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 600;
        color: var(--accent);
        padding: 0.35rem 0.75rem;
        border: 1px solid rgb(var(--gray-light));
        border-radius: 999px;
        margin: 0 0 1.25rem;
        background: #fff;
      }
      .hero h1 {
        font-size: 2.4rem !important;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 0 0 1rem;
        font-weight: 700;
      }
      .hero h1 .accent { color: var(--accent); }
      .lede {
        font-size: 1.1rem;
        line-height: 1.6;
        color: rgb(var(--gray-dark));
        margin: 0 0 1.5rem;
        max-width: 44ch;
      }
      .credentials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1rem;
        font-size: 0.85rem;
        color: rgb(var(--gray));
        margin: 0 0 1.75rem;
      }
      .credentials span { display: inline-flex; align-items: center; gap: 0.35rem; }
      .credentials .dot { color: rgb(var(--gray-light)); }

      .cta-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.25rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: transform 0.12s ease, opacity 0.12s ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-secondary {
        border: 1px solid rgb(var(--gray-light));
        color: rgb(var(--gray-dark));
        background: #fff;
      }

      .hero-photo {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        border: 4px solid #fff;
      }

      /* POSTS */
      section h2.section-title {
        font-size: 0.85rem !important;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: rgb(var(--gray));
        margin: 0 0 1.5rem;
        font-weight: 600;
      }
      ul.post-list { list-style: none; padding: 0; margin: 0; }
      ul.post-list li {
        padding: 1.5rem 0;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      ul.post-list li:first-child { padding-top: 0; }
      ul.post-list a { text-decoration: none; color: inherit; display: block; }
      ul.post-list a:hover .post-title { color: var(--accent); }
      .post-title {
        font-size: 1.35rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
        line-height: 1.3;
      }
      .post-date { font-size: 0.85rem; color: rgb(var(--gray)); margin: 0; }
      .post-desc {
        margin: 0.5rem 0 0;
        color: rgb(var(--gray-dark));
        line-height: 1.55;
      }
      .see-all {
        display: inline-block;
        margin-top: 1.25rem;
        font-size: 0.95rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
      }
      .see-all:hover { text-decoration: underline; }

      /* MOBILE */
      @media (max-width: 640px) {
        main { padding: 2rem 1.1rem 3rem; }
        .hero {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding: 1rem 0 2rem;
          margin-bottom: 2rem;
          text-align: center;
        }
        .hero-text { order: 2; }
        .hero-photo-wrap { order: 1; display: flex; justify-content: center; }
        .hero-photo { width: 120px; height: 120px; }
        .hero h1 { font-size: 1.75rem !important; }
        .eyebrow { font-size: 0.65rem; letter-spacing: 0.08em; }
        .lede { font-size: 1rem; margin-left: auto; margin-right: auto; }
        .credentials { justify-content: center; }
        .cta-row { justify-content: center; }
        .btn { padding: 0.55rem 1rem; font-size: 0.9rem; }
        .post-title { font-size: 1.1rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-text">
          <p class="eyebrow">Software Architect · AI Engineer</p>
          <h1>Building software in the <span class="accent">age of AI.</span></h1>
          <p class="lede">
            I’m Balaji Bankapur — a Senior Principal Software Engineer exploring
            how AI is reshaping the way we design, build, and maintain real
            systems. Practical write-ups from an engineer’s perspective.
          </p>
          <p class="credentials">
            <span>20+ years in engineering</span>
            <span class="dot">•</span>
            <span>Operating systems → healthcare → AI</span>
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/blog">Read the latest post →</a>
            <a class="btn btn-secondary" href="/about">More about me</a>
          </div>
        </div>
        <div class="hero-photo-wrap">
          <Image
            src={balajiPhoto}
            alt="Balaji Bankapur"
            width={320}
            height={320}
            class="hero-photo"
            loading="eager"
          />
        </div>
      </section>

      <section class="posts">
        <h2 class="section-title">Latest writing</h2>
        <ul class="post-list">
          {posts.slice(0, 5).map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <p class="post-title">{post.data.title}</p>
                <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
        {posts.length > 5 && <a class="see-all" href="/blog">See all posts →</a>}
      </section>
    </main>
    <Footer />
  </body>
</html>
